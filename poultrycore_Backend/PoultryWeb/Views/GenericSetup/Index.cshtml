@model PoultryWeb.Models.Generic.GenericCompanySetupRequestVm
@{
    Layout = "_GenericLayout";
    ViewData["Title"] = "Generic Company Setup";
    var categories = ViewBag.Categories as List<PoultryWeb.Models.Generic.BusinessCategoryVm>
                     ?? new List<PoultryWeb.Models.Generic.BusinessCategoryVm>();
    var hasProfile = ViewBag.HasProfile is bool b && b;
}

<div class="card shadow-sm">
    <div class="card-body">
        <h4 class="card-title">@(hasProfile ? "Update business profile" : "Set up your business")</h4>
        <p class="text-muted">
            @if (!hasProfile)
            {
                <text>Choose your business category and basic details. We'll seed default expense categories, cash accounts, customer/supplier types, and payment methods so you can start using the app immediately.</text>
            }
            else
            {
                <text>Update your business profile. Default lookups stay as they are; this form does not re-seed them.</text>
            }
        </p>

        <form asp-action="Index" method="post" class="row g-3">
            @Html.AntiForgeryToken()

            <div class="col-md-6">
                <label class="form-label">Business category</label>
                <select asp-for="BusinessCategoryId" class="form-select">
                    <option value="">— Choose —</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.BusinessCategoryId"
                                selected="@(Model.BusinessCategoryId == c.BusinessCategoryId)">
                            @c.Name
                        </option>
                    }
                </select>
                <small class="text-muted">Restaurant, hotel, shop, salon, pharmacy, etc.</small>
            </div>

            <div class="col-md-6">
                <label class="form-label">Default currency</label>
                <input asp-for="DefaultCurrency" class="form-control" maxlength="10" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Owner name</label>
                <input asp-for="OwnerName" class="form-control" maxlength="150" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Phone number</label>
                <input asp-for="PhoneNumber" class="form-control" maxlength="50" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Main location</label>
                <input asp-for="MainLocation" class="form-control" maxlength="255" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Business start date</label>
                <input asp-for="BusinessStartDate" type="date" class="form-control" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Opening cash balance (GHC)</label>
                <input asp-for="OpeningCashBalance" type="number" step="0.01" class="form-control" />
                <small class="text-muted">Seeds the "Main Cash Box" account.</small>
            </div>

            <div class="col-12">
                <label class="form-label">Short description</label>
                <textarea asp-for="BusinessDescription" rows="2" class="form-control" maxlength="500"></textarea>
            </div>

            <div class="col-12">
                <label class="form-label">Notes</label>
                <textarea asp-for="Notes" rows="2" class="form-control" maxlength="1000"></textarea>
            </div>

            <div class="col-12 d-flex justify-content-end gap-2">
                <a asp-action="Index" asp-controller="GenericDashboard" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    @(hasProfile ? "Save changes" : "Set up & continue")
                </button>
            </div>
        </form>
    </div>
</div>
