@*
    Layout for Generic Company pages. Mirrors _Layout.cshtml but the sidebar
    routes to the GenericXxx controllers. Use Layout = "_GenericLayout" in any
    Generic Company view.
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PoultryWeb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PoultryWeb.styles.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <nav class="col-12 col-md-3 col-xl-2 px-0 sidebar min-vh-100">
                <div class="d-flex flex-column align-items-center align-items-md-start px-3 pt-3 text-white">
                    <a href="@Url.Action("Index", "GenericDashboard")" class="d-flex align-items-center pb-3 mb-md-0 me-md-auto text-white text-decoration-none">
                        <span class="fs-5 d-none d-md-inline">🏪 Business</span>
                    </a>
                    <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-center align-items-md-start w-100">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item w-100"><a class="nav-link text-white" href="@Url.Action("Index", "GenericDashboard")">📊 Dashboard</a></li>
                            <li class="nav-item w-100"><a class="nav-link text-white" href="@Url.Action("Index", "GenericSales")">💰 Sales</a></li>
                            <li class="nav-item w-100"><a class="nav-link text-white" href="@Url.Action("Index", "GenericProducts")">📦 Products</a></li>
                            <li class="nav-item w-100"><a class="nav-link text-white" href="@Url.Action("Index", "GenericCustomers")">👥 Customers</a></li>
                            <li class="nav-item w-100"><a class="nav-link text-white" href="@Url.Action("Index", "GenericSuppliers")">🚚 Suppliers</a></li>
                            <li class="nav-item w-100"><a class="nav-link text-white" href="@Url.Action("Index", "GenericPurchases")">🛒 Purchases</a></li>
                            <li class="nav-item w-100"><a class="nav-link text-white" href="@Url.Action("Index", "GenericExpenses")">🧾 Expenses</a></li>
                            <li class="nav-item w-100"><a class="nav-link text-white" href="@Url.Action("Index", "GenericCashAccounts")">💵 Cash & Accounts</a></li>
                            <li class="nav-item w-100"><a class="nav-link text-white" href="@Url.Action("Index", "GenericDailyClosings")">📅 Daily Closing</a></li>
                            <li class="nav-item w-100"><a class="nav-link text-white" href="@Url.Action("Index", "GenericSetup")">⚙️ Setup</a></li>

                            <li class="nav-item w-100 mt-3"><a class="nav-link text-warning" href="@Url.Action("Index", "Home")">↩️ Switch farm</a></li>
                            <li class="nav-item w-100"><a class="nav-link text-danger" href="/Account/LogoutView">🚪 Logout</a></li>
                        }
                        else
                        {
                            <li class="nav-item w-100"><a class="nav-link text-danger" href="/Account/Login">🚪 Login</a></li>
                        }
                    </ul>
                </div>
            </nav>

            <main class="col-12 col-md-9 col-xl-10 py-3">
                <div class="row mb-3 align-items-center">
                    <div class="col text-start">
                        <h5>@ViewData["Title"]</h5>
                    </div>
                    <div class="col text-center text-muted">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var farmName = User.Claims.FirstOrDefault(c => c.Type == "FarmName")?.Value;
                            if (!string.IsNullOrEmpty(farmName))
                            {
                                <span class="fw-semibold">@farmName</span>
                            }
                        }
                    </div>
                    <div class="col text-end text-muted">
                        Logged in as
                        <strong>
                            @{
                                var roleClaim = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role);
                                @roleClaim?.Value
                                ;
                            }
                        </strong>
                    </div>
                </div>

                @if (TempData["Success"] is string ok)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @ok
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] is string err)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @err
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()

                <footer class="footer text-center py-3 mt-4 border-top">
                    <span>&copy; 2025 - PoultryWeb (Generic Company)</span>
                </footer>
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
