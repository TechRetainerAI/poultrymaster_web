@model List<PoultryWeb.Models.Generic.GenericExpenseVm>
@{
    Layout = "_GenericLayout";
    ViewData["Title"] = "Expenses";
    var status = ViewBag.Status as string;
    string Money(decimal v) => $"GHC {v:N2}";
    string Badge(string s) => s switch
    {
        "Draft"     => "bg-secondary",
        "Submitted" => "bg-info text-dark",
        "Approved"  => "bg-success",
        "Rejected"  => "bg-danger",
        "Cancelled" => "bg-secondary",
        _           => "bg-light text-dark"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="btn-group btn-group-sm">
        <a asp-action="Index" class="btn @(string.IsNullOrEmpty(status) ? "btn-primary" : "btn-outline-primary")">All</a>
        <a asp-action="Index" asp-route-status="Draft"    class="btn @(status == "Draft"    ? "btn-primary" : "btn-outline-primary")">Draft</a>
        <a asp-action="Index" asp-route-status="Approved" class="btn @(status == "Approved" ? "btn-primary" : "btn-outline-primary")">Approved</a>
        <a asp-action="Index" asp-route-status="Rejected" class="btn @(status == "Rejected" ? "btn-primary" : "btn-outline-primary")">Rejected</a>
    </div>
    <small class="text-muted">Create expenses via API (Part 2 will add a UI form).</small>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No expenses yet.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Supplier</th>
                        <th>Paid via</th>
                        <th class="text-end">Amount</th>
                        <th>Status</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td>#@e.GenericExpenseId</td>
                        <td>@e.ExpenseDate.ToString("yyyy-MM-dd")</td>
                        <td>@(e.CategoryName ?? "—")</td>
                        <td>@(e.Description ?? "—")</td>
                        <td>@(e.SupplierName ?? "—")</td>
                        <td><small class="text-muted">@e.PaymentMethod</small></td>
                        <td class="text-end">@Money(e.Amount)</td>
                        <td><span class="badge @Badge(e.Status)">@e.Status</span></td>
                        <td class="text-end">
                            @if (e.Status == "Draft" || e.Status == "Submitted")
                            {
                                <form asp-action="Approve" method="post" class="d-inline"
                                      onsubmit="return confirm('Approve this expense?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@e.GenericExpenseId" />
                                    <button class="btn btn-sm btn-success">Approve</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
