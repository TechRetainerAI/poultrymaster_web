@model List<PoultryWeb.Models.Generic.GenericSaleVm>
@{
    Layout = "_GenericLayout";
    ViewData["Title"] = "Sales";
    var status = ViewBag.Status as string;
    string Money(decimal v) => $"GHC {v:N2}";

    string StatusBadge(string s) => s switch
    {
        "Draft"     => "bg-secondary",
        "Approved"  => "bg-success",
        "Cancelled" => "bg-danger",
        "Refunded"  => "bg-warning text-dark",
        _           => "bg-light text-dark",
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="btn-group btn-group-sm">
        <a asp-action="Index" class="btn @(string.IsNullOrEmpty(status) ? "btn-primary" : "btn-outline-primary")">All</a>
        <a asp-action="Index" asp-route-status="Draft"     class="btn @(status == "Draft"     ? "btn-primary" : "btn-outline-primary")">Draft</a>
        <a asp-action="Index" asp-route-status="Approved"  class="btn @(status == "Approved"  ? "btn-primary" : "btn-outline-primary")">Approved</a>
        <a asp-action="Index" asp-route-status="Refunded"  class="btn @(status == "Refunded"  ? "btn-primary" : "btn-outline-primary")">Refunded</a>
        <a asp-action="Index" asp-route-status="Cancelled" class="btn @(status == "Cancelled" ? "btn-primary" : "btn-outline-primary")">Cancelled</a>
    </div>
    <a asp-action="Create" class="btn btn-success">+ New sale</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No sales yet. Click <strong>+ New sale</strong> to record your first one.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Type</th>
                        <th class="text-end">Total</th>
                        <th class="text-end">Paid</th>
                        <th class="text-end">Balance</th>
                        <th>Status</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@s.GenericSaleId">#@s.GenericSaleId</a></td>
                        <td>@s.SaleDate.ToString("yyyy-MM-dd")</td>
                        <td>@(s.CustomerName ?? "Walk-in")</td>
                        <td><small class="text-muted">@s.SalesType</small></td>
                        <td class="text-end">@Money(s.TotalAmount)</td>
                        <td class="text-end">@Money(s.AmountPaid)</td>
                        <td class="text-end @(s.Balance > 0 ? "text-danger fw-semibold" : "")">@Money(s.Balance)</td>
                        <td><span class="badge @StatusBadge(s.Status)">@s.Status</span></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@s.GenericSaleId" class="btn btn-sm btn-outline-secondary">Details</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
