@model List<PoultryWeb.Models.Generic.GenericDailyClosingVm>
@{
    Layout = "_GenericLayout";
    ViewData["Title"] = "Daily closings";
    string Money(decimal v) => $"GHC {v:N2}";
    string Badge(string s) => s switch
    {
        "Draft"     => "bg-secondary",
        "Submitted" => "bg-info text-dark",
        "Approved"  => "bg-success",
        "Rejected"  => "bg-danger",
        _           => "bg-light text-dark"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">@Model.Count closing(s)</p>
    <a asp-action="Create" class="btn btn-primary">+ Close today</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No daily closings yet. Click <strong>+ Close today</strong> to count cash and submit your first one.
        The totals (sales, expenses, customer payments, etc.) are computed automatically.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th class="text-end">Sales</th>
                        <th class="text-end">Expenses</th>
                        <th class="text-end">Expected cash</th>
                        <th class="text-end">Actual cash</th>
                        <th class="text-end">Difference</th>
                        <th>Status</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.ClosingDate.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">@Money(c.TotalSales)</td>
                        <td class="text-end">@Money(c.TotalExpenses)</td>
                        <td class="text-end">@Money(c.ExpectedCash)</td>
                        <td class="text-end">@Money(c.ActualCashCounted)</td>
                        <td class="text-end @(c.CashDifference != 0 ? "text-danger fw-semibold" : "")">
                            @Money(c.CashDifference)
                        </td>
                        <td><span class="badge @Badge(c.Status)">@c.Status</span></td>
                        <td class="text-end">
                            @if (c.Status == "Submitted")
                            {
                                <form asp-action="Approve" method="post" class="d-inline"
                                      onsubmit="return confirm('Approve and lock this closing?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@c.GenericDailyClosingId" />
                                    <button class="btn btn-sm btn-success">Approve</button>
                                </form>
                                <form asp-action="Submit" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@c.GenericDailyClosingId" />
                                    <button class="btn btn-sm btn-outline-secondary" title="Refresh totals">↻</button>
                                </form>
                            }
                            else if (c.Status == "Draft")
                            {
                                <form asp-action="Submit" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@c.GenericDailyClosingId" />
                                    <button class="btn btn-sm btn-primary">Submit</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
