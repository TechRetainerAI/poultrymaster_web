@model PoultryWeb.Models.Generic.GenericDashboardVm
@{
    Layout = "_GenericLayout";
    ViewData["Title"] = "Dashboard";
    string Money(decimal v) => $"GHC {v:N2}";
}

@* Headline cards *@
<div class="row g-3">
    <div class="col-md-3">
        <div class="card text-bg-success shadow-sm">
            <div class="card-body">
                <div class="text-uppercase small">Today's Sales</div>
                <h3 class="mb-0">@Money(Model.Today.TodaySales)</h3>
                <small class="opacity-75">Yesterday: @Money(Model.Today.YesterdaySales)</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-warning shadow-sm">
            <div class="card-body">
                <div class="text-uppercase small">Today's Expenses</div>
                <h3 class="mb-0">@Money(Model.Today.TodayExpenses)</h3>
                <small class="opacity-75">Purchases paid: @Money(Model.Today.TodayPurchasesPaid)</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-primary shadow-sm">
            <div class="card-body">
                <div class="text-uppercase small">Today's Profit</div>
                <h3 class="mb-0">@Money(Model.Today.TodayGrossProfit)</h3>
                <small class="opacity-75">Sales − expenses (gross)</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-dark shadow-sm">
            <div class="card-body">
                <div class="text-uppercase small">Cash at Hand</div>
                <h3 class="mb-0">@Money(Model.Today.CashAtHand)</h3>
                <small class="opacity-75">@Model.CashAccounts.Count active accounts</small>
            </div>
        </div>
    </div>
</div>

@* Second row *@
<div class="row g-3 mt-1">
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-uppercase small text-muted">Inventory value</div>
                <h4 class="mb-0">@Money(Model.Today.InventoryValue)</h4>
                <small class="text-muted">at cost price</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-uppercase small text-muted">Customer debt</div>
                <h4 class="mb-0">@Money(Model.Today.CustomerDebt)</h4>
                <small class="text-muted">@Model.Alerts.CustomersOwingCount customers owing</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-uppercase small text-muted">Supplier debt</div>
                <h4 class="mb-0">@Money(Model.Today.SupplierDebt)</h4>
                <small class="text-muted">@Model.Alerts.SuppliersOwedCount suppliers owed</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm @(Model.Alerts.LowStockCount > 0 ? "border-danger" : "")">
            <div class="card-body">
                <div class="text-uppercase small text-muted">Low stock</div>
                <h4 class="mb-0">@Model.Alerts.LowStockCount products</h4>
                <small class="text-muted">at or below minimum</small>
            </div>
        </div>
    </div>
</div>

@* Week summary *@
<div class="row g-3 mt-1">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="text-uppercase text-muted small">This week (last 7 days)</h6>
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="text-muted small">Sales</div>
                        <div class="fs-5 fw-semibold">@Money(Model.Week.WeekSales)</div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-muted small">Expenses</div>
                        <div class="fs-5 fw-semibold">@Money(Model.Week.WeekExpenses)</div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-muted small">Purchases paid</div>
                        <div class="fs-5 fw-semibold">@Money(Model.Week.WeekPurchasesPaid)</div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-muted small">Gross profit</div>
                        <div class="fs-5 fw-semibold text-success">@Money(Model.Week.WeekGrossProfit)</div>
                    </div>
                </div>
                <hr />
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="text-muted small">Top selling</div>
                        <div>
                            @if (string.IsNullOrEmpty(Model.Week.TopSellingItem))
                            { <span class="text-muted">No sales this week.</span> }
                            else
                            { <strong>@Model.Week.TopSellingItem</strong>
                              <span class="text-muted">— @Model.Week.TopSellingQuantity sold</span>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Top expense</div>
                        <div>
                            @if (string.IsNullOrEmpty(Model.Week.TopExpenseCategory))
                            { <span class="text-muted">No expenses this week.</span> }
                            else
                            { <strong>@Model.Week.TopExpenseCategory</strong>
                              <span class="text-muted">— @Money(Model.Week.TopExpenseAmount)</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Cash accounts *@
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="text-uppercase text-muted small">Cash accounts</h6>
                @if (Model.CashAccounts.Count == 0)
                {
                    <p class="text-muted mb-0">No cash accounts yet. Run setup.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <tbody>
                            @foreach (var a in Model.CashAccounts)
                            {
                                <tr>
                                    <td>@a.AccountName <small class="text-muted">(@a.AccountType)</small></td>
                                    <td class="text-end fw-semibold">@Money(a.CurrentBalance)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@* Quick actions *@
<div class="row mt-4">
    <div class="col-12">
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="GenericSales" asp-action="Create" class="btn btn-success">+ New sale</a>
            <a asp-controller="GenericCustomers" asp-action="Create" class="btn btn-outline-primary">+ New customer</a>
            <a asp-controller="GenericSuppliers" asp-action="Create" class="btn btn-outline-primary">+ New supplier</a>
            <a asp-controller="GenericDailyClosings" asp-action="Create" class="btn btn-outline-dark">+ Daily closing</a>
            @if (Model.Alerts.PendingClosingsCount > 0)
            {
                <a asp-controller="GenericDailyClosings" asp-action="Index" class="btn btn-warning">
                    @Model.Alerts.PendingClosingsCount pending closing(s) →
                </a>
            }
            @if (Model.Alerts.DraftSalesCount > 0)
            {
                <a asp-controller="GenericSales" asp-action="Index" asp-route-status="Draft" class="btn btn-outline-warning">
                    @Model.Alerts.DraftSalesCount draft sale(s) →
                </a>
            }
        </div>
    </div>
</div>
