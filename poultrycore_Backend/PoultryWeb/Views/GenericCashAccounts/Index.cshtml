@model List<PoultryWeb.Models.Generic.GenericCashAccountVm>
@{
    Layout = "_GenericLayout";
    ViewData["Title"] = "Cash & accounts";
    string Money(decimal v) => $"GHC {v:N2}";
    decimal totalActive = Model.Where(a => a.IsActive).Sum(a => a.CurrentBalance);
}

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card text-bg-success shadow-sm">
            <div class="card-body">
                <div class="text-uppercase small">Total cash at hand</div>
                <h3 class="mb-0">@Money(totalActive)</h3>
                <small class="opacity-75">Across @Model.Count(a => a.IsActive) active account(s)</small>
            </div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No cash accounts. Run setup to seed defaults (Main Cash Box, MoMo, Bank, Petty Cash).</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Account</th>
                        <th>Type</th>
                        <th class="text-end">Opening</th>
                        <th class="text-end">Current</th>
                        <th>Allows negative</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td><strong>@a.AccountName</strong></td>
                        <td><small class="text-muted">@a.AccountType</small></td>
                        <td class="text-end">@Money(a.OpeningBalance)</td>
                        <td class="text-end fw-semibold @(a.CurrentBalance < 0 ? "text-danger" : "")">@Money(a.CurrentBalance)</td>
                        <td>@(a.AllowNegativeBalance ? "Yes" : "No")</td>
                        <td>
                            @if (a.IsActive) { <span class="badge bg-success">Active</span> }
                            else             { <span class="badge bg-secondary">Inactive</span> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="mt-3 text-muted small">
    Cash transfers between accounts, manual adjustments, and reconciliation will get UI forms in Phase 6a Part 2.
    Until then use POST <code>/api/generic-company/{farmId}/cash/...</code>.
</div>
