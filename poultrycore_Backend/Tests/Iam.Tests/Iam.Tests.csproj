<Project Sdk="Microsoft.NET.Sdk">

  <!-- Page access / IAM authorization tests. Pure logic (route map, filter
       decisions) runs anywhere; the database tests in DatabaseTests.cs are
       skipped unless IAM_ITEST_CONN points at a Postgres database that has
       migrations 506 + 507, and every one of them rolls itself back. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>

  <ItemGroup>
    <None Include="page-keys.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PoultryFarmAPI\PoultryFarmAPI.csproj" />
  </ItemGroup>

</Project>
