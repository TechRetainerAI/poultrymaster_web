@model List<PoultryWeb.Models.Generic.GenericCustomerVm>
@{
    Layout = "_GenericLayout";
    ViewData["Title"] = "Customers";
    string Money(decimal v) => $"GHC {v:N2}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">@Model.Count customer(s)</p>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ New customer</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No customers yet. Create your first one.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Phone</th>
                        <th>Location</th>
                        <th class="text-end">Credit limit</th>
                        <th class="text-end">Owes us</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><strong>@c.CustomerName</strong></td>
                        <td><span class="badge bg-light text-dark">@c.CustomerType</span></td>
                        <td>@(c.PhoneNumber ?? "—")</td>
                        <td>@(c.Location ?? "—")</td>
                        <td class="text-end">@(c.CreditLimit > 0 ? Money(c.CreditLimit) : "—")</td>
                        <td class="text-end @(c.CurrentBalance > 0 ? "text-danger fw-semibold" : "")">
                            @Money(c.CurrentBalance)
                        </td>
                        <td>
                            @if (!c.IsActive) { <span class="badge bg-secondary">Inactive</span> }
                            else if (c.IsOverLimit) { <span class="badge bg-danger">Over limit</span> }
                            else if (c.CurrentBalance > 0) { <span class="badge bg-warning text-dark">Owes</span> }
                            else { <span class="badge bg-success">OK</span> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
