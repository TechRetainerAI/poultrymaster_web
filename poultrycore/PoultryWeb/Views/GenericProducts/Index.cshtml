@model List<PoultryWeb.Models.Generic.GenericProductVm>
@{
    Layout = "_GenericLayout";
    ViewData["Title"] = "Products";
    string Money(decimal v) => $"GHC {v:N2}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">@Model.Count product(s)</p>
    <small class="text-muted">Create / edit products via API or admin tools for now.</small>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No products yet. Use POST <code>/api/generic-company/{farmId}/products</code> to create one.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>SKU</th>
                        <th>Category</th>
                        <th class="text-end">Cost</th>
                        <th class="text-end">Selling</th>
                        <th class="text-end">Stock</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            <strong>@p.ProductName</strong>
                            @if (!string.IsNullOrEmpty(p.UnitOfMeasure))
                            { <small class="text-muted">/ @p.UnitOfMeasure</small> }
                        </td>
                        <td><code>@p.SKU</code></td>
                        <td>@(p.CategoryName ?? "—")</td>
                        <td class="text-end">@Money(p.CostPrice)</td>
                        <td class="text-end">@Money(p.SellingPrice)</td>
                        <td class="text-end">
                            @if (p.TrackInventory)
                            { @p.CurrentStock.ToString("0.###") }
                            else
                            { <span class="text-muted">n/a</span> }
                        </td>
                        <td>
                            @if (!p.IsActive)
                            { <span class="badge bg-secondary">Inactive</span> }
                            else if (p.IsLowStock)
                            { <span class="badge bg-danger">Low stock</span> }
                            else
                            { <span class="badge bg-success">OK</span> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
