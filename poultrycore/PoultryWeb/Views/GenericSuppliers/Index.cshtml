@model List<PoultryWeb.Models.Generic.GenericSupplierVm>
@{
    Layout = "_GenericLayout";
    ViewData["Title"] = "Suppliers";
    string Money(decimal v) => $"GHC {v:N2}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">@Model.Count supplier(s)</p>
    <a asp-action="Create" class="btn btn-primary btn-sm">+ New supplier</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No suppliers yet. Create your first one.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Phone</th>
                        <th>Location</th>
                        <th class="text-end">Terms</th>
                        <th class="text-end">We owe them</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td><strong>@s.SupplierName</strong></td>
                        <td><span class="badge bg-light text-dark">@s.SupplierType</span></td>
                        <td>@(s.PhoneNumber ?? "—")</td>
                        <td>@(s.Location ?? "—")</td>
                        <td class="text-end">@(s.PaymentTermsDays > 0 ? $"{s.PaymentTermsDays}d" : "—")</td>
                        <td class="text-end @(s.CurrentBalance > 0 ? "text-danger fw-semibold" : "")">
                            @Money(s.CurrentBalance)
                        </td>
                        <td>
                            @if (!s.IsActive) { <span class="badge bg-secondary">Inactive</span> }
                            else if (s.CurrentBalance > 0) { <span class="badge bg-warning text-dark">Owed</span> }
                            else { <span class="badge bg-success">OK</span> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
