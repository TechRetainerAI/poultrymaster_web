# =============================================================================
# EASIEST setup — run ONLY the web app locally, pointed at the live DEV backend.
# No .NET, no SQL Server needed. Copy this file to ".env.local" and run:
#
#     npm install
#     npm run dev
#
# Then open http://localhost:3000
# =============================================================================

# Farm API (water / poultry / generic business data) — DEV Cloud Run
NEXT_PUBLIC_API_BASE_URL=https://poultrymaster-farm-api-dev-t6tn7geswq-ew.a.run.app
FARM_API_URL=https://poultrymaster-farm-api-dev-t6tn7geswq-ew.a.run.app

# Login API (auth / companies / payments) — DEV Cloud Run
NEXT_PUBLIC_ADMIN_API_URL=https://poultrymaster-login-api-dev-t6tn7geswq-ew.a.run.app
NEXT_PUBLIC_LOGIN_API_URL=https://poultrymaster-login-api-dev-t6tn7geswq-ew.a.run.app
ADMIN_API_URL=https://poultrymaster-login-api-dev-t6tn7geswq-ew.a.run.app

# -----------------------------------------------------------------------------
# To run the backend locally instead (only if you're changing the .NET APIs),
# see README.md → "Option B". Point these at your local APIs, e.g.:
#   NEXT_PUBLIC_API_BASE_URL=localhost:7190
#   NEXT_PUBLIC_ADMIN_API_URL=localhost:7010
#   FARM_API_URL=https://localhost:7190
#   ADMIN_API_URL=https://localhost:7010
# -----------------------------------------------------------------------------
